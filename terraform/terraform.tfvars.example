# Azure Authentication Options
azure_subscription_id = "your-azure-subscription-id-here"
azure_tenant_id       = "your-azure-tenant-id-here"

# Resource Naming & Location
location     = "East US"
project_name = "nexus-supply"
environment  = "prod"
acr_name     = "pgsupplyregistry"

# Supply secrets through TF_VAR_postgres_admin_password and TF_VAR_jwt_secret.
# For first startup only: TF_VAR_bootstrap_admin_email / TF_VAR_bootstrap_admin_password.
postgres_admin_username = "enterprise_admin"

# Get production and staging outboundIpAddresses/possibleOutboundIpAddresses
# from Azure. The empty default blocks PostgreSQL network access.
postgres_allowed_ips = {}
