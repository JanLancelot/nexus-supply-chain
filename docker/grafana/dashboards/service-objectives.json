      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (last_over_time(nexus:slo_bad:increase30d{environment=\"$environment\",slo=\"$slo\"}[65m]) / (last_over_time(nexus:slo_requests:increase30d{environment=\"$environment\",slo=\"$slo\"}[65m]) > 0))) and (nexus:slo_sample_valid{environment=\"$environment\",slo=\"$slo\"} == 1)",
