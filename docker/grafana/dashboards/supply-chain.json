{
  "uid": "nexus-supply-chain",
  "title": "Nexus · Supply chain",
  "description": "Last successful database snapshots of products, stock and order states, with freshness and collection status. Shared database totals are deduplicated across selected backend instances.",
  "id": null,
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "tags": [
    "nexus",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Nexus dashboards",
      "type": "dashboards",
      "tags": [
        "nexus"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nexus-prometheus"
        },
        "query": {
          "query": "label_values(nexus_observability_refresh_success{job=\"spring-backend\"}, environment)",
          "refId": "environments"
        },
        "definition": "label_values(nexus_observability_refresh_success{job=\"spring-backend\"}, environment)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "instance",
        "label": "Backend instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nexus-prometheus"
        },
        "query": {
          "query": "label_values(nexus_observability_refresh_success{job=\"spring-backend\",environment=~\"$environment\"}, instance)",
          "refId": "instances"
        },
        "definition": "label_values(nexus_observability_refresh_success{job=\"spring-backend\",environment=~\"$environment\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Reading these snapshots",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Counts retain the last successful snapshot when collection fails. Check snapshot age and refresh status before acting.** Snapshots refresh every 30 seconds by default. Totals use the maximum across selected replicas to avoid counting the same shared database twice; select one instance when comparing different databases within an environment. Inventory value uses the application’s configured currency."
      }
    },
    {
      "id": 2,
      "title": "Business snapshot healthy",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(nexus_observability_refresh_success{job=\"spring-backend\",instance=~\"$instance\",environment=~\"$environment\",component=\"business\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          }
        }
      ]
    },
