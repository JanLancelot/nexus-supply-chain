  "panels": [
    {
      "id": 1,
      "title": "Operations scope",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Scrape availability checks the private backend metrics endpoint. API quality covers `/api/v1/*` only, excluding health probes. Blank latency charts are expected before traffic arrives. **Prometheus evaluates alerts; external notifications require configured Alertmanager receivers.**"
      }
    },
    {
      "id": 2,
      "title": "Backend scrape available",
      "type": "stat",
      "description": "1 = all selected metrics targets reachable; 0 = one or more failed. This is not an external website uptime check.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"spring-backend\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nexus-prometheus"
          }
        }
      ]
    },
